{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "idea-analysis.input",
    "type": "object",
    "required": ["idea"],
    "properties": {
      "idea": { "type": "string", "description": "Free-text description of the business idea" },
      "location": { "type": "string", "description": "City/region/country, if known" },
      "target_customer": { "type": "string" },
      "known_constraints": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Anything already fixed: budget ceiling, land availability, regulations, etc."
      }
    }
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "idea-analysis.output",
    "type": "object",
    "required": ["idea_summary", "value_proposition", "assumptions", "open_questions", "recommended_next_skills"],
    "properties": {
      "idea_summary": { "type": "string" },
      "problem_statement": { "type": "string" },
      "value_proposition": { "type": "string" },
      "target_segments": {
        "type": "array",
        "items": { "type": "string" }
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["assumption", "confidence"],
          "properties": {
            "assumption": { "type": "string" },
            "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
            "needs_validation_by": {
              "type": "string",
              "description": "Which downstream skill should validate this, e.g. 'market-research'"
            }
          }
        }
      },
      "open_questions": {
        "type": "array",
        "items": { "type": "string" }
      },
      "risks_preview": {
        "type": "array",
        "items": { "type": "string" }
      },
      "recommended_next_skills": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Ordered skill ids the orchestrator should consider running next"
      }
    }
  }
}
